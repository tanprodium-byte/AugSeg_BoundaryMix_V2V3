{
  "dataset": {
    "ignore_label": 255,
    "mean": [
      0.485,
      0.456,
      0.406
    ],
    "n_sup": 2646,
    "std": [
      0.229,
      0.224,
      0.225
    ],
    "train": {
      "batch_size": 16,
      "crop": {
        "size": [
          321,
          321
        ],
        "type": "rand"
      },
      "data_list": "./data/splitsall/pascal_u2pl/2646/labeled.txt",
      "data_root": "./data/VOC2012",
      "flip": true,
      "rand_resize": [
        0.5,
        2.0
      ],
      "resize_base_size": 500,
      "strong_aug": {
        "flag_use_random_num_sampling": true,
        "num_augs": 3
      }
    },
    "type": "pascal_semi",
    "val": {
      "batch_size": 1,
      "data_list": "./data/splitsall/pascal_u2pl/val.txt",
      "data_root": "./data/VOC2012"
    },
    "workers": 4
  },
  "net": {
    "decoder": {
      "kwargs": {
        "dilations": [
          6,
          12,
          18
        ],
        "inner_planes": 256,
        "low_conv_planes": 48
      },
      "type": "augseg.models.decoder.dec_deeplabv3_plus"
    },
    "ema_decay": 0.999,
    "encoder": {
      "kwargs": {
        "multi_grid": true,
        "replace_stride_with_dilation": [
          false,
          false,
          true
        ],
        "zero_init_residual": true
      },
      "pretrain": "./pretrained/resnet101.pth",
      "type": "augseg.models.resnet.resnet101"
    },
    "num_classes": 21,
    "sync_bn": true
  },
  "trainer": {
    "epochs": 80,
    "evaluate_student": true,
    "lr_scheduler": {
      "kwargs": {
        "power": 0.9
      },
      "mode": "poly"
    },
    "optimizer": {
      "kwargs": {
        "lr": 0.000125,
        "momentum": 0.9,
        "weight_decay": 0.0001
      },
      "type": "SGD"
    },
    "sup_only_epoch": 0,
    "unsupervised": {
      "flag_extra_weak": false,
      "loss_weight": 1.0,
      "threshold": 0.95,
      "use_cutmix": true,
      "use_cutmix_adaptive": true,
      "use_cutmix_trigger_prob": 1.0
    }
  },
  "criterion": {
    "kwargs": {
      "use_weight": false
    },
    "type": "CELoss"
  },
  "saliency_cutmix": {
    "apply_to": "labeled_source_only",
    "box_expand_ratio": 1.2,
    "component_score": "mean_saliency_area",
    "component_source": "labeled_gt",
    "connectivity": 8,
    "debug_log": false,
    "detach_saliency": true,
    "direct_confidence_gate": false,
    "direct_labeled_mix": false,
    "direct_paste_policy": "same_coordinate",
    "enabled": false,
    "eps": 1e-06,
    "fallback": "random_box",
    "foreground_only": true,
    "ignore_label": 255,
    "max_component_area": 20000,
    "min_component_area": 64,
    "mode": "box",
    "num_candidates": 8,
    "paste_mode": "box",
    "saliency_loss": "supervised_ce",
    "saliency_mode": "grad",
    "saliency_model": "teacher",
    "selection": "softmax",
    "temperature": 0.2,
    "use_saliency_conf_product": false,
    "use_saliency_for_loss_weight": false
  }
}
