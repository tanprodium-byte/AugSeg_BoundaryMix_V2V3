 def get_git_commit(repo_root: str | Path = ".") -> str:
+    # This isolated deployment has no .git directory. The parent commit is only
+    # a label; source_pin/source_diff in each manifest identify the actual source.
+    pin_path = os.environ.get("AUGSEG_DEPLOYMENT_PIN")
+    if pin_path:
+        import hashlib
+        payload = Path(pin_path).read_bytes()
+        pin = json.loads(payload)
+        if (hashlib.sha256(payload).hexdigest() != os.environ.get("AUGSEG_DEPLOYMENT_PIN_SHA256")
+                or Path(pin["deployment_root"]) != Path(__file__).resolve().parents[1]
+                or pin["file_hashes"]["util/run_logging.py"] != hashlib.sha256(Path(__file__).read_bytes()).hexdigest()):
+            raise RuntimeError("isolated source attestation mismatch")
+        return pin["source_commit"][:7]
