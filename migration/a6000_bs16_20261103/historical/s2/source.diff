+def actual_gt_paste_stats(origin, mixed_target, fallback_ratio, ignore_index=255):
+    """Exact post-mix GT-origin counts, including ignored GT, before CE filtering.
+
+    This reads the provenance mask returned by the production mixer; it does not
+    infer paste area from changed labels. No sampling or mutation occurs here.
+    """
+    if origin.shape != mixed_target.shape:
+        raise ValueError("GT-origin/target shape mismatch")
+    gt = origin.detach().gt(.5)
+    valid = mixed_target.detach().ne(ignore_index)
+    total = gt.numel()
+    count = int(gt.sum().item()); good = int((gt & valid).sum().item())
+    return {"s2/gt_origin_pixels": count, "s2/valid_gt_origin_pixels": good,
+        "s2/ignore_gt_origin_pixels": count-good, "s2/grid_pixels": total,
+        "s2/gt_origin_fraction": count/total, "s2/valid_gt_origin_fraction": good/total,
+        "s2/ignore_gt_origin_fraction": (count-good)/total,
+        "s2/mixed_sample_fraction": float(gt.flatten(1).any(1).float().mean().item()),
+        "s2/component_fallback_sample_fraction": float(fallback_ratio), "s2/mixing_stages": 1.0}
