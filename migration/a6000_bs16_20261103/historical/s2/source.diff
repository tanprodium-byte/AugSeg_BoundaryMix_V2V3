+def validate_s2_area_only_config(cfg):
+    """Opt-in checks; absent new score key preserves historical defaults."""
+    s = cfg.get("saliency_cutmix", {})
+    if s.get("component_score", "mean_saliency_area") != "area_only":
+        return False
+    expected = {"enabled": True, "mode": "component_mask", "direct_labeled_mix": True,
+        "direct_paste_policy": "component_mask_random_valid_destination", "paste_mode": "mask",
+        "component_source": "labeled_gt", "connectivity": 8, "foreground_only": True,
+        "ignore_label": 255, "min_component_area": 64, "max_component_area": 20000,
+        "temperature": .2, "selection": "softmax", "fallback": "random_box",
+        "saliency_model": "teacher", "saliency_loss": "supervised_ce", "saliency_mode": "grad",
+        "detach_saliency": True, "use_saliency_for_loss_weight": False, "use_saliency_conf_product": False}
+    for key, value in expected.items():
+        if s.get(key) != value:
+            raise ValueError("S2 area-only contract mismatch: " + key)
+    if s.get("direct_confidence_gate", False) or s.get("eps", 1e-6) != 1e-6:
+        raise ValueError("S2 area-only must retain no gate and epsilon1e-6")
+    for key in ("csl", "csl_cutmix", "fixed_size_csl_destination", "boundary_component",
+                "boundary_compatibility", "boundary_mix", "u1_saliency_u2u",
+                "u2_cross_view_saliency_u2u", "u3_confidence_filtered_cross_view_saliency_u2u",
+                "u4_confidence_filtered_self_pseudo_saliency_u2u"):
+        if cfg.get(key, {}).get("enabled", False):
+            raise ValueError("S2 area-only forbids extra branch: " + key)
+    t = cfg["trainer"]; d = cfg["dataset"]
+    if (t["epochs"], t.get("sup_only_epoch", 0), d["n_sup"], d["train"]["batch_size"], d["train"]["crop"]["size"]) != (80, 0, 662, 16, [321,321]):
+        raise ValueError("S2 area-only requires fixed80 VOC662/C321/B16")
+    u = t["unsupervised"]
+    if (u["threshold"], u["loss_weight"], u.get("flag_extra_weak", False), u["use_cutmix"], u["use_cutmix_adaptive"], u["use_cutmix_trigger_prob"]) != (.95, 1., False, True, True, 1.):
+        raise ValueError("S2 area-only must retain baseline CE/BHW and trigger")
+    return True
+
